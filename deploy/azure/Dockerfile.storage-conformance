# syntax=docker/dockerfile:1.7

ARG RUST_VERSION=1.95
ARG DEBIAN_VERSION=bookworm

FROM rust:${RUST_VERSION}-${DEBIAN_VERSION} AS builder
WORKDIR /build
COPY . .
RUN cargo test --release --locked -p buzz-azure-storage \
      --test azurite_conformance --no-run \
    && test_binary="$(find target/release/deps -maxdepth 1 \
      -type f -name 'azurite_conformance-*' -perm /111 | head -1)" \
    && test -n "${test_binary}" \
    && install -D -m 0755 "${test_binary}" /out/buzz-azure-conformance

FROM debian:${DEBIAN_VERSION}-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 1000 buzz \
    && useradd --system --uid 1000 --gid 1000 --home-dir /var/lib/buzz \
      --create-home --shell /usr/sbin/nologin buzz
COPY --from=builder /out/buzz-azure-conformance /usr/local/bin/buzz-azure-conformance
USER buzz:buzz
WORKDIR /var/lib/buzz
ENTRYPOINT ["/usr/local/bin/buzz-azure-conformance", "--nocapture"]
